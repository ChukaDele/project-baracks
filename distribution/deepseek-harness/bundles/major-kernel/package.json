{
  "name": "@major/dsh-kernel",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lima-subprocess": "./lima-subprocess.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lima-subprocess.js",
    "cordis.patch.yml"
  ],
  "version": "0.0.0-shadow",
  "dependencies": {
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.8"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
